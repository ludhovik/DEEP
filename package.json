    "test-converters": "python -m unittest discover -s tests -p 'test_*.py'",
    "test-viewer": "node --test tests/test_viewer_regressions.mjs tests/test_earth_surface.mjs tests/test_field_line_tubes.mjs tests/test_viewer_status.mjs tests/test_figshare_proxy.mjs"
  },
  "dependencies": {
    "lil-gui": "latest",
    "three": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
