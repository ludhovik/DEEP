{
  "name": "deepscope-viewer",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "make-data": "python tools/make_demo_data.py",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "convert-state": "python tools/convert_state_to_viewer.py",
    "convert-xshells": "python tools/convert_xshells_to_viewer.py",
